# ---- Shared ----
NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgresql://embr:embr_dev_password@localhost:5432/embr_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Mail (MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@embr.health

# Auth (Milestone 2) — generate real secrets with `openssl rand -hex 32`,
# never reuse these placeholders past local dev.
APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32-chars-min
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32-chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
COOKIE_DOMAIN=
# Local/dev value — leave unset in production. When unset, this now
# defaults to true automatically outside NODE_ENV=development/test, so
# a production deploy gets Secure cookies even if this line is never
# copied into its real env config. Set explicitly here only to keep
# local HTTP dev working.
COOKIE_SECURE=false

# Error monitoring (Milestone 11) — optional. Leave unset in dev/CI;
# Sentry.init() is skipped entirely when this is empty. Shared by
# apps/api and apps/worker (each process gets its own DSN/project in
# Sentry so errors are attributed correctly — set both if using both).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Web (apps/web) ----
# Server-side only — used by next.config.ts's rewrite to proxy browser
# calls to /api/* through to the real API, so the API's cookies land as
# first-party cookies in the browser (see apps/web/src/lib/api-client.ts).
API_URL=http://localhost:4000
# Currently unused (apps/web talks to the API via the same-origin proxy
# above, not directly) — kept for any future server-side direct calls.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Admin (apps/admin) ----
# Server-side only — same purpose as apps/web's API_URL above (this
# app's next.config.ts proxies /api/* the same way). Both apps point
# at the same API server, so this is the same value as API_URL unless
# you're routing admin traffic through a separate API instance.
# API_URL=http://localhost:4000
# Currently unused, same reasoning as apps/web's NEXT_PUBLIC_API_URL above.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000

# ---- Mobile (apps/mobile) ----
# Unlike web/admin, there's no same-origin proxy to hide behind — the
# app calls the API directly (see apps/mobile/lib/api-client.ts), so
# this has to be reachable from wherever the app is actually running,
# not just from this machine. `localhost` only works if the app itself
# is running on this machine (e.g. `expo start --web`). An Android
# emulator reaches the host machine at 10.0.2.2, not localhost; an iOS
# simulator can usually use localhost directly; a physical device
# needs this machine's real LAN IP (e.g. http://192.168.1.23:4000) and
# both devices on the same network. Must be prefixed EXPO_PUBLIC_ —
# that's the only prefix Expo inlines into the built app at all.
EXPO_PUBLIC_API_URL=http://localhost:4000
