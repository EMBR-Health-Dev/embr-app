{
  "name": "embr-platform",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "EMBR \u2014 evidence infrastructure for menopause",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @embr/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @embr/api exec prisma generate",
    "db:studio": "pnpm --filter @embr/api exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.7.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.69.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "@types/node": "^22.20.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "brace-expansion": ">=2.1.2 <3",
      "nanoid": ">=3.3.18",
      "deepmerge-ts": ">=8.0.0",
      "uuid": ">=11.1.1",
      "@opentelemetry/core": "^1.30.1"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  }
}
