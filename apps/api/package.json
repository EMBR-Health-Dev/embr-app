{
  "name": "@embr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/generated && cp -R src/generated dist/generated",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@embr/shared": "workspace:*",
    "@embr/types": "workspace:*",
    "@embr/validation": "workspace:*",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^8.47.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^7.5.0",
    "rate-limit-redis": "^4.3.1",
    "ioredis": "^5.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.0",
    "zod": "^3.24.0",
    "argon2": "^0.41.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.0",
    "@anthropic-ai/sdk": "^0.116.0",
    "pdfkit": "^0.15.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/supertest": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/node": "^22.20.1",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "vite": "^6.4.3"
  }
}
