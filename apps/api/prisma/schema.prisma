// EMBR — Prisma schema
//
// Milestone 2 — Authentication. Domain models (SymptomLog, CycleEntry,
// ...) land in Milestone 3 and reference User by id; nothing here is
// expected to be redesigned when they arrive.

generator client {
  provider = "prisma-client-js"
  // Generated to an explicit project-local path rather than the default
  // node_modules/@prisma/client. In a pnpm workspace with
  // moduleResolution: NodeNext, resolving the default location depends
  // on how pnpm's isolated node_modules + @prisma/client's package.json
  // "exports" map interact, which has proven unreliable in CI even when
  // `prisma generate` itself succeeds. A relative import path removes
  // that ambiguity entirely.
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

/// A registered account. Passwords are never stored in plaintext — only
/// an argon2id hash. `emailVerifiedAt` gates access to features that
/// require a confirmed email (see requireVerifiedEmail middleware).
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            Role      @default(MEMBER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  symptomLogs             SymptomLog[]
  cycleEntries            CycleEntry[]
  treatments              Treatment[]
  organizationMemberships OrganizationMembership[]
  sentOrganizationInvites OrganizationInvite[]
  clinicalBriefs          ClinicalBrief[]
  onboardingProfile       OnboardingProfile?

  @@map("users")
}

/// A refresh-token-backed device session. Refresh tokens are never
/// stored in plaintext — only a SHA-256 hash — so a leaked database
/// dump cannot be replayed as a session. Rotated on every /auth/refresh
/// call; `replacedBySessionId` lets us detect refresh-token reuse
/// (a strong signal of theft) and revoke the whole chain.
model Session {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash    String    @unique
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use token emailed to confirm account ownership. Only the hash
/// is stored; `consumedAt` enforces single use without needing to
/// delete (and thus lose the audit trail of) the row.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Single-use token emailed for the forgot-password flow. Issuing a new
/// one invalidates prior unconsumed tokens for the same user (see
/// auth.repository.ts) so only the most recently requested link works.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Append-only security/audit trail for auth events (register, login,
/// login failure, password change, session revocation, ...). `userId`
/// is nullable and SET NULL on delete so the trail survives account
/// deletion for as long as retention policy requires.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---- Core domain (Milestone 3) ----

enum SymptomCategory {
  HOT_FLASH
  NIGHT_SWEATS
  MOOD_CHANGE
  SLEEP_DISTURBANCE
  BRAIN_FOG
  JOINT_PAIN
  FATIGUE
  ANXIETY
  IRREGULAR_HEARTBEAT
  VAGINAL_DRYNESS
  LIBIDO_CHANGE
  WEIGHT_CHANGE
  HEADACHE
  OTHER
}

enum SeverityLevel {
  MILD
  MODERATE
  SEVERE
}

/// A single symptom occurrence a user logs. `occurredAt` is
/// user-supplied (when the symptom happened) and is deliberately
/// separate from `createdAt` (when the log entry was saved) — perimenopause
/// symptoms are very often logged after the fact, sometimes the next
/// morning for a night-time hot flash.
model SymptomLog {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   SymptomCategory
  severity   SeverityLevel
  occurredAt DateTime
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, occurredAt])
  @@map("symptom_logs")
}

enum FlowIntensity {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

/// One entry per user per calendar day (see the unique constraint below),
/// covering both period-flow tracking and the period start/end markers
/// cycle-length calculations need. Perimenopause cycles are frequently
/// irregular or entirely absent for stretches, so every field here is
/// optional except the date itself — a day can be logged with just
/// `notes` and nothing else.
model CycleEntry {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime       @db.Date
  flow          FlowIntensity?
  isPeriodStart Boolean        @default(false)
  isPeriodEnd   Boolean        @default(false)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("cycle_entries")
}

enum TreatmentCategory {
  HRT
  SUPPLEMENT
  MEDICATION
  LIFESTYLE
  OTHER
}

/// A treatment or intervention the user is tracking — the "what was
/// done" layer that symptom/cycle logs alone don't capture. `endDate`
/// null means ongoing/current, same nullable-means-open-ended pattern
/// as OrganizationInvite's `consumedAt`. Deliberately no separate
/// "outcome" model: correlating a treatment's date range against the
/// existing SymptomLog/CycleEntry history already covers "what changed
/// afterward" without a new table to keep in sync — see
/// trends.repository.ts if that ever needs its own dedicated endpoint.
model Treatment {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  TreatmentCategory
  startDate DateTime          @db.Date
  endDate   DateTime?         @db.Date
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, startDate])
  @@map("treatments")
}

// ---- Organizations (Milestone 12) ----
//
// The B2B/enterprise counterpart to the individual `User` accounts every
// prior milestone was built around. Deliberately additive: a `User` with
// no OrganizationMembership behaves exactly as it always has (this is
// still an optional relation, not a required tenant column). Existing
// personal-data boundaries are unchanged — see OrganizationMembership's
// doc comment for the specific line this draws.

enum OrgRole {
  ORG_ADMIN
  ORG_MEMBER
}

/// A B2B customer account (an employer, insurer, or clinic purchasing
/// covered access for its members). Provisioned by EMBR ops today, not
/// self-serve — see organization.routes.ts for why that's a platform-ADMIN
/// action rather than an open signup flow, matching the sales-assisted
/// pilot-to-enterprise progression the business already runs on.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// Null = no seat limit enforced yet (pilot-stage default). Set once a
  /// real contract has a seat count to enforce. As of the billing
  /// module (see modules/billing), a Stripe subscription's seat
  /// quantity is one way this gets set — see billing.service.ts's
  /// applySubscriptionState — but it remains directly, manually
  /// settable too (pilot/ops provisioning never required Stripe and
  /// still doesn't).
  seatLimit Int?

  // ---- Billing (Stripe) ----
  //
  // All nullable: an org with no billing relationship yet (every org
  // provisioned before this module existed, and any pilot org that
  // stays manually invoiced) simply has all four unset. Never treat
  // "no Stripe customer yet" as an error state — see billing.service.ts.
  /// Stripe Customer id (cus_...). Created lazily on first checkout-
  /// session request, then reused — see billing.service.ts's
  /// createCheckoutSession.
  stripeCustomerId String? @unique
  /// Stripe Subscription id (sub_...). Set from the subscription
  /// lifecycle webhooks (created/updated), cleared never — a canceled
  /// subscription keeps its id for history; subscriptionStatus is what
  /// changes to CANCELED.
  stripeSubscriptionId String?             @unique
  subscriptionStatus   StripeSubscriptionStatus?
  /// End of the current billing period for the active subscription, as
  /// reported by Stripe on the same webhooks that set the two fields
  /// above. Null whenever stripeSubscriptionId is.
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMembership[]
  invites       OrganizationInvite[]
  ssoConnection OrganizationSsoConnection?

  @@map("organizations")
}

// ---- Billing (Stripe) ----

/// Mirrors Stripe's own Subscription.status values exactly (see
/// https://docs.stripe.com/api/subscriptions/object#subscription_object-status)
/// so mapping a webhook payload to this column is a straight uppercase,
/// never a judgment call about what a given Stripe status "really
/// means" — see billing.webhook.ts.
enum StripeSubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

/// Idempotency ledger for Stripe webhook delivery. Stripe's own docs
/// guarantee at-least-once delivery, not exactly-once — a retried or
/// duplicated event must not double-apply (e.g. reprocessing an already
/// -handled subscription.updated is harmless here since every handler
/// sets absolute values rather than incrementing, but recording this
/// deliberately rather than relying on that happening to be true keeps
/// the guarantee explicit and keeps a duplicate out of the audit trail
/// twice). `id` is the Stripe event id (evt_...) itself, not a
/// generated uuid — the natural key for "have we seen this one."
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

/// Links a User to an Organization. Deliberately does NOT grant the org
/// or its ORG_ADMINs any access to that member's SymptomLog/CycleEntry
/// rows — those stay exactly as private as Milestone 3 and Milestone 7
/// already established for the platform-ADMIN case. What ORG_ADMIN
/// actually gets: the member roster (this table) and anonymized,
/// cohort-level trend aggregates (see organization.trends in the
/// service layer) — never an individual member's records.
///
/// One membership per (organization, user) — schema allows a user to
/// belong to multiple organizations over time (e.g. a job change), but
/// the invite/accept flow in this milestone only ever creates one at a
/// time; nothing here assumes single-org exclusivity going forward.
model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(ORG_MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

/// Single-use, emailed invitation to join an organization — same
/// hashed-token, single-consumption pattern as EmailVerificationToken /
/// PasswordResetToken (see auth.repository.ts). Issuing a new invite for
/// the same (org, email) pair invalidates prior unconsumed ones for that
/// pair, mirroring how a fresh password-reset request supersedes older
/// links.
model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole      @default(ORG_MEMBER)
  tokenHash      String       @unique
  invitedByUserId String
  invitedBy      User         @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

// ---- SSO (Milestone 15) ----
//
// OIDC-only for now (see docs/MILESTONES.md Milestone 15 for why SAML
// isn't in scope yet) and coexists with password login rather than
// replacing it — `enforced` exists so a later milestone can add
// SSO-only enforcement without another migration, but nothing reads it
// yet.

enum SsoProtocol {
  OIDC
}

/// An organization's configured SSO identity provider connection. One
/// per organization (not a list) — enterprise customers overwhelmingly
/// standardize on a single IdP; supporting more later is additive, not
/// a schema break, if a real customer ever needs it.
model OrganizationSsoConnection {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  protocol       SsoProtocol  @default(OIDC)
  /// The IdP's issuer URL (OIDC discovery is done against
  /// `${issuerUrl}/.well-known/openid-configuration`).
  issuerUrl String
  clientId  String
  /// AES-256-GCM ciphertext, never the plaintext secret — see
  /// sso.crypto.ts. Reversible (unlike PasswordHash) because the API
  /// must present this back to the IdP's token endpoint on every login;
  /// a one-way hash can't work here the way it does for User passwords.
  encryptedClientSecret String
  /// Only emails at this domain may authenticate (and be JIT-
  /// provisioned) through this connection — see sso.service.ts. Without
  /// this gate, any account the IdP happens to authenticate would be
  /// able to join the organization, regardless of who it actually
  /// belongs to.
  allowedEmailDomain String
  enabled            Boolean  @default(false)
  /// Not read anywhere yet — see the file-level note above.
  enforced  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_sso_connections")
}

// ---- Clinical briefs (EMBR BRIEF) ----
//
// A generated, persisted point-in-time snapshot — not a live view.
// Re-downloading later must reproduce exactly what was generated, even
// if the person has since edited or added logs in that date range, so
// the structured summary AND the AI-generated text are both stored
// here rather than recomputed on read. See brief.ai.ts for the (very
// deliberately narrow) scope of what the AI is allowed to say.

/// A generated clinical brief: a structured summary of symptom/cycle
/// data over a date range, plus an AI-generated narrative and
/// discussion-topic list intended to help a GP conversation, not
/// replace one. Never contains raw free-text symptom-log notes — see
/// brief.service.ts for why those are deliberately excluded from what
/// gets sent to the model.
model ClinicalBrief {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromDate DateTime
  toDate   DateTime

  /// Array<{ category: SymptomCategory, count: number, severityBreakdown: Record<SeverityLevel, number> }>
  symptomSummary Json
  /// { averageCycleLengthDays: number | null, cycleCount: number, periodDaysLogged: number }
  cycleSummary Json
  /// Array<{ name: string, category: TreatmentCategory, startDate: string, endDate: string | null }>
  /// A snapshot of Treatment records overlapping [fromDate, toDate],
  /// taken at generation time — deliberately NOT a live query (see
  /// brief.pdf.ts's reproducibility invariant). Never sent to the AI —
  /// see brief.ai.ts's BriefInput, which this is not part of. notes is
  /// deliberately excluded — see treatment-summary.ts's doc comment.
  treatmentSummary Json

  /// Array<{ category, currentCount, previousCount, absoluteChange, percentageChange: number | null, direction }>
  /// See period-comparison.ts for the exact comparison-window
  /// definition. Nullable, unlike the three summaries above — added
  /// after those, so a brief generated before this field existed has
  /// no value to backfill (recomputing it would violate this model's
  /// own point-in-time-snapshot invariant against data that may no
  /// longer reflect what generation time saw). Null means "never
  /// computed for this brief"; an empty array means the comparison
  /// ran and found no categories logged in either period — the two
  /// are different facts. Never sent to the AI as of this milestone.
  frequencyComparison Json?

  /// { categoryA: SymptomCategory, categoryB: SymptomCategory, days: number } | null
  /// Computed over the brief's own requested period only, via the
  /// existing apps/api/src/modules/trends/co-occurrence.ts pattern
  /// engine — never a second implementation. That function returns at
  /// most one pair (or null below its own threshold), so unlike
  /// frequencyComparison above, null here is deliberately overloaded:
  /// "never computed for this brief" and "computed, no qualifying
  /// pair" are not distinguished — see BriefFrequencyComparisonEntryDto's
  /// sibling doc comment in @embr/types for why that's fine here
  /// specifically. Never sent to the AI as of this milestone.
  coOccurrence Json?

  /// Array<{ treatmentId, name, category, windowDays, before: {logCount, days}, after: {logCount, days}, insufficientData }>
  /// One entry per Treatment that *started* inside [fromDate, toDate]
  /// — not every treatment overlapping the period (treatmentSummary
  /// above already covers that). Computed via the existing
  /// apps/api/src/modules/treatments/treatment-impact.ts window/count
  /// logic, the same function GET /treatments/:id/impact already
  /// uses — never a second implementation. Nullable/empty-array
  /// distinction matches frequencyComparison's reasoning: an empty
  /// array is a real fact ("no treatments started this period"), so
  /// null ("never computed for this brief") must stay distinguishable
  /// from it. This raw field itself is never sent to the AI — only a
  /// derived, treatment-name-stripped projection is, via
  /// `interpretation` below (see stage4-ai-projection.ts).
  treatmentImpact Json?

  /// Array<SymptomCategory> — derived purely from frequencyComparison
  /// above, no new counting. A category qualifies when reported at
  /// all in the previous period and still at or above a floor in the
  /// current one — see persistent-symptoms.ts for the exact rule.
  /// Nullable/empty-array distinction matches frequencyComparison's
  /// reasoning: an empty array is a real fact ("nothing qualified"),
  /// so null ("never computed for this brief") must stay
  /// distinguishable from it. No Stage 4 pattern type maps to this, so
  /// it is never sent to the AI in any form.
  persistentSymptoms Json?

  /// { interpretationVersion: string, patterns: Stage4Pattern[] }
  /// The canonical Stage 4 result (see @embr/types and
  /// stage4-interpretation.ts) — the same object computed once during
  /// generation, used to validate the AI's response
  /// (stage4-validation.ts), and persisted here unchanged, never
  /// recomputed. Safe to persist and render in full, including
  /// treatment names inside treatment_window_changed patterns'
  /// observation text — that's a different concern from what's safe
  /// to send to the AI (see stage4-ai-projection.ts for the
  /// treatment-name-stripped copy used for that). Null for a brief
  /// generated before this field existed; never backfilled, same
  /// reasoning as every other additive field on this model.
  interpretation Json?

  aiNarrative        String
  /// string[] — see brief.ai.ts's system prompt for the exact framing
  /// constraint (questions to ask, never assertions or suggestions).
  aiDiscussionTopics Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("clinical_briefs")
}

// ---- Onboarding (Milestone 18) ----
//
// One row per user, created lazily on the first PATCH /onboarding
// call — a user with no row at all is equivalent to one with
// completedAt: null (see onboarding.mappers.ts's toOnboardingProfileDto,
// which returns the same "nothing yet" shape for both). Every field
// here is either a closed, purpose-built enum or a plain timestamp —
// deliberately NOT the real SymptomCategory enum for noticedAreas (see
// OnboardingArea below), and deliberately no appointment date field at
// all (see OnboardingAppointmentStatus) — both are onboarding-specific
// vocabularies that must never be confused with, or joined against,
// real clinical data.

enum OnboardingJobToBeDone {
  UNDERSTAND_EXPERIENCE
  UNDERSTAND_PATTERNS
  PREPARE_FOR_APPOINTMENT
  KEEP_RECORD
  NOT_SURE
}

/// Broad, non-clinical buckets a new user can pick from during
/// onboarding to personalize their first logging screen — NOT the real
/// SymptomCategory taxonomy. Each bucket maps to several real
/// categories client-side (see apps/web and apps/mobile's onboarding
/// screens) purely for which chips get pre-highlighted; the mapping
/// never happens server-side and a selection here never creates a
/// SymptomLog.
enum OnboardingArea {
  SLEEP
  ENERGY
  MOOD
  BODY
  FOCUS
}

/// Coarse enough that no appointment date is ever collected during
/// onboarding — see docs/MILESTONES.md's Milestone 18 entry for why an
/// exact date was deliberately deferred to a future "Appointment Mode."
enum OnboardingAppointmentStatus {
  WITHIN_MONTH
  UNSURE_WHEN
  NO
  UNSURE
}

/// Which of the five onboarding screens the person last reached —
/// purely for resuming an interrupted onboarding at the right screen,
/// not read for anything else.
enum OnboardingStep {
  WELCOME
  JOB_TO_BE_DONE
  WHATS_GOING_ON
  APPOINTMENT_STATUS
  THE_LOOP
}

model OnboardingProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobToBeDone       OnboardingJobToBeDone?
  noticedAreas      OnboardingArea[]             @default([])
  appointmentStatus OnboardingAppointmentStatus?
  currentStep       OnboardingStep?

  /// True if the person explicitly skipped to the dashboard rather than
  /// reaching the final screen — completedAt is set either way (both
  /// mean "don't show onboarding again"); this is the one field that
  /// distinguishes them for later analysis.
  skipped     Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_profiles")
}
