{
  "name": "@embr/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@embr/shared": "workspace:*",
    "@sentry/node": "^8.47.0",
    "bullmq": "^5.81.5",
    "ioredis": "^5.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "@types/node": "^22.20.5",
    "vite": "^6.4.4"
  }
}
