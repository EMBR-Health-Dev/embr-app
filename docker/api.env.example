# docker/api.env.example — copy to docker/api.env before first
# `docker compose -f docker/docker-compose.yml up`.
#
#   cp docker/api.env.example docker/api.env
#
# docker/api.env is gitignored: real values never enter the repo.
# The api's env schema (apps/api/src/config/env.ts) hard-fails boot
# without all four of these — fail-closed by design.

# JWT signing secrets. Both must be at least 32 characters.
# Generate fresh ones per machine:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-refresh-secret-at-least-32-chars

# SSO OIDC client-secret encryption key: base64-encoded 32-byte value
# (rotating it invalidates every stored org SSO secret).
#   openssl rand -base64 32
SSO_ENCRYPTION_KEY=replace-me-base64-32-byte-key

# Anthropic API key for the EMBR BRIEF feature. Any non-empty string
# boots the API (the feature fails at call time without a real key);
# put a real key here when you want briefs to generate.
ANTHROPIC_API_KEY=local-dev-placeholder

# Everything else the api needs (DATABASE_URL, REDIS_URL, SMTP,
# CORS_ORIGIN) is set by docker-compose.yml's `environment:` block,
# which takes precedence over this file for any key both define.